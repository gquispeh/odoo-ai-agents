<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">

    <record id="group_ov_ve_user" model="res.groups">
        <field name="name">Virtual Employees · Supervisor</field>
        <field name="comment">Can hire, supervise, and approve runs for virtual employees in their own company.</field>
    </record>

    <record id="group_ov_ve_manager" model="res.groups">
        <field name="name">Virtual Employees · Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_ov_ve_user'))]"/>
        <field name="comment">Can configure roles, capabilities, policies, budgets across all companies.</field>
    </record>

    <!-- Multi-company record rules: supervisors see their company's employees -->
    <record id="rule_ov_virtual_employee_company" model="ir.rule">
        <field name="name">Virtual Employee: own company</field>
        <field name="model_id" ref="model_ov_virtual_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ov_ve_user'))]"/>
    </record>

</odoo>
