<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- =========================================================== -->
    <!-- Employee form: the hire                                       -->
    <!-- =========================================================== -->
    <record id="view_ov_virtual_employee_form" model="ir.ui.view">
        <field name="name">ov.virtual.employee.form</field>
        <field name="model">ov.virtual.employee</field>
        <field name="arch" type="xml">
            <form string="Virtual Employee">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate"
                            class="oe_highlight"
                            invisible="state not in ('draft',)"/>
                    <button name="action_run_now" type="object"
                            string="Run Tasks Now"
                            invisible="state not in ('active',)"/>
                    <button name="action_open_chat" type="object"
                            string="Open Supervision Chat"
                            invisible="state == 'draft'"/>
                    <button name="action_pause" type="object"
                            string="Pause"
                            invisible="state not in ('active','busy','over_budget')"/>
                    <button name="action_resume" type="object"
                            string="Resume"
                            invisible="state not in ('paused','over_budget')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,busy,paused"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_runs" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                        <button name="action_open_runs" type="object"
                                class="oe_stat_button" icon="fa-hourglass-half"
                                context="{'search_default_filter_awaiting': 1}">
                            <field name="pending_action_count" widget="statinfo" string="Awaiting"/>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'over_budget'">
                        <strong>Daily budget exceeded.</strong>
                        <field name="pause_reason" nolabel="1" readonly="1"/>
                        The employee is paused until the next UTC day or until you raise the cap.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'paused'">
                        <strong>Paused.</strong>
                        <field name="pause_reason" nolabel="1" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="avatar" style="margin-right:12px; font-size:32px;"/>
                            <field name="name" placeholder="Give your hire a name…"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="role_id" options="{'no_create': True}"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="hr_employee_id" options="{'no_create_edit': True}"/>
                            <field name="last_run_summary" readonly="1"/>
                        </group>
                        <group string="Trust &amp; Budget">
                            <field name="trust_level"/>
                            <field name="max_daily_cost_usd"/>
                            <field name="current_daily_cost_usd" readonly="1"/>
                            <field name="max_daily_actions"/>
                        </group>
                    </group>
                    <group>
                        <group string="Working Hours">
                            <field name="timezone"/>
                            <label for="work_hour_start" string="Working Window"/>
                            <div>
                                <field name="work_hour_start" widget="float_time" class="oe_inline"/>
                                <span> — </span>
                                <field name="work_hour_end" widget="float_time" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Capabilities &amp; Autonomy" name="policies">
                            <p class="text-muted">
                                Each row sets autonomy for one capability. AUTO bypasses the
                                preview step (the audit row still gets written). CONFIRM
                                stages a creator request for human approval. READONLY only
                                lets the employee suggest. OFF disables the capability.
                            </p>
                            <field name="policy_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="capability_id" options="{'no_create': True}"/>
                                    <field name="capability_risk" widget="badge"
                                           decoration-success="capability_risk == 'low'"
                                           decoration-warning="capability_risk == 'medium'"
                                           decoration-danger="capability_risk == 'high'"/>
                                    <field name="autonomy"/>
                                    <field name="daily_quota"/>
                                    <field name="daily_used"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="objective"/>
                                    <field name="trigger"/>
                                    <field name="cadence_hours" invisible="trigger != 'cron'"/>
                                    <field name="event_model" invisible="trigger != 'event'"/>
                                    <field name="last_fired_at" readonly="1"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <button name="action_fire_now" type="object"
                                            string="Fire Now" class="btn-link"
                                            icon="fa-bolt"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recent Runs" name="runs">
                            <field name="run_ids" nolabel="1" readonly="1">
                                <list decoration-warning="state == 'awaiting_approval'"
                                      decoration-success="state == 'completed'"
                                      decoration-danger="state == 'failed'"
                                      limit="20">
                                    <field name="name"/>
                                    <field name="create_date"/>
                                    <field name="trigger_kind"/>
                                    <field name="total_cost_usd"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =========================================================== -->
    <!-- Kanban: the workforce dashboard                               -->
    <!-- =========================================================== -->
    <record id="view_ov_virtual_employee_kanban" model="ir.ui.view">
        <field name="name">ov.virtual.employee.kanban</field>
        <field name="model">ov.virtual.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="role_id"/>
                <field name="role_icon"/>
                <field name="trust_level"/>
                <field name="state"/>
                <field name="last_run_summary"/>
                <field name="avatar"/>
                <field name="current_daily_cost_usd"/>
                <field name="max_daily_cost_usd"/>
                <field name="pending_action_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3" style="border-left:4px solid #1E3A8A;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div style="font-size:32px; line-height:1;">
                                        <field name="avatar"/>
                                    </div>
                                    <div class="mt-2"><strong style="font-size:15px;"><field name="name"/></strong></div>
                                    <div class="text-muted small"><field name="role_id"/></div>
                                </div>
                                <div>
                                    <span class="badge text-bg-primary"><field name="trust_level"/></span>
                                </div>
                            </div>
                            <div class="mt-2 small text-muted">
                                <field name="last_run_summary"/>
                            </div>
                            <div class="d-flex justify-content-between mt-3 small">
                                <span>State: <strong><field name="state"/></strong></span>
                                <span t-if="record.pending_action_count.raw_value &gt; 0"
                                      class="badge text-bg-warning">
                                    <field name="pending_action_count"/> awaiting
                                </span>
                            </div>
                            <div class="mt-2 small text-muted">
                                $<field name="current_daily_cost_usd"/> / $<field name="max_daily_cost_usd"/> today
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ov_virtual_employee_list" model="ir.ui.view">
        <field name="name">ov.virtual.employee.list</field>
        <field name="model">ov.virtual.employee</field>
        <field name="arch" type="xml">
            <list string="Virtual Employees"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'busy'"
                  decoration-warning="state == 'paused'"
                  decoration-danger="state == 'over_budget'"
                  decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="role_id"/>
                <field name="trust_level"/>
                <field name="state" widget="badge"/>
                <field name="current_daily_cost_usd"/>
                <field name="max_daily_cost_usd"/>
                <field name="pending_action_count"/>
                <field name="last_run_summary"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ov_virtual_employee_search" model="ir.ui.view">
        <field name="name">ov.virtual.employee.search</field>
        <field name="model">ov.virtual.employee</field>
        <field name="arch" type="xml">
            <search string="Virtual Employees">
                <field name="name"/>
                <field name="role_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('state','=','active')]"/>
                <filter string="Over Budget" name="filter_over_budget"
                        domain="[('state','=','over_budget')]"/>
                <filter string="Paused" name="filter_paused" domain="[('state','=','paused')]"/>
                <group>
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Trust Level" name="group_trust" context="{'group_by': 'trust_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ov_virtual_employee" model="ir.actions.act_window">
        <field name="name">Virtual Employees</field>
        <field name="res_model">ov.virtual.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ov_virtual_employee_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hire your first virtual employee</p>
            <p>Pick a role, give the hire a name, and they will be created
            in shadow mode. Raise the trust dial as you build confidence.</p>
        </field>
    </record>

</odoo>
