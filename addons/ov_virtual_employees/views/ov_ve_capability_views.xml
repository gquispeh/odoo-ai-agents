<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_ov_ve_capability_list" model="ir.ui.view">
        <field name="name">ov.virtual.employee.capability.list</field>
        <field name="model">ov.virtual.employee.capability</field>
        <field name="arch" type="xml">
            <list string="Capabilities">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="handler_model"/>
                <field name="handler_method"/>
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"/>
                <field name="requires_confirmation_by_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ov_ve_capability_form" model="ir.ui.view">
        <field name="name">ov.virtual.employee.capability.form</field>
        <field name="model">ov.virtual.employee.capability</field>
        <field name="arch" type="xml">
            <form string="Capability">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Reconcile Bank Statements"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="handler_model"/>
                            <field name="handler_method"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="requires_confirmation_by_default"/>
                            <field name="creator_template_code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Supported Roles" name="roles">
                            <field name="supports_role_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ov_ve_capability" model="ir.actions.act_window">
        <field name="name">Capabilities</field>
        <field name="res_model">ov.virtual.employee.capability</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No capabilities defined</p>
            <p>Capabilities are atomic skills a virtual employee can execute.
            Each one dispatches to a Python method on a handler model.</p>
        </field>
    </record>

</odoo>
